# Browser-visible (Vite requires the VITE_ prefix to expose these client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — never prefix these with VITE_, or they'd ship to the client
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Used by scripts/seed.ts only (same values as SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
